{
  "routes": [
    { "pathPrefix": "/api/auth", "pool": "auth" },
    { "pathPrefix": "/api/analytics", "pool": "analytics" },
    { "pathPrefix": "/", "pool": "links" }
  ],
  "pools": {
    "auth": [
      "http://auth-service:8080"
    ],
    "analytics": [
      "http://analytics-service:8080"
    ],
    "links": [
      "http://link-service-1:8080",
      "http://link-service-2:8080",
      "http://link-service-3:8080"
    ]
  },
  "healthCheck": {
    "path": "/health",
    "intervalSeconds": 2,
    "timeoutSeconds": 2
  }
}
