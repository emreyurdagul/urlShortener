{
  "routes": [
    { "pathPrefix": "/api/auth", "pool": "auth" },
    { "pathPrefix": "/api/analytics", "pool": "analytics" },
    { "pathPrefix": "/", "pool": "links" }
  ],
  "pools": {
    "auth": [
      "http://urlshortener_auth-service_1:8080"
    ],
    "analytics": [
      "http://urlshortener_analytics-service_1:8080"
    ],
    "links": [
      "http://urlshortener_link-service_1:8080",
      "http://urlshortener_link-service_2:8080",
      "http://urlshortener_link-service_3:8080"
    ]
  },
  "healthCheck": {
    "path": "/health",
    "intervalSeconds": 2,
    "timeoutSeconds": 2
  }
}
